[user]
	email = psiegel@gravisrobotics.com
	name = Peter Siegel
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILbpVGiNHDh1CGXRMP72ZMGLPFSmHau8ODKU2ev1Zfc0
[gpg]
	format = ssh
[gpg "ssh"]
	program = "/opt/1Password/op-ssh-sign"
[commit]
	gpgsign = true
[init]
	defaultBranch = main
[credential]
	helper = "!f() { /home/psiegel/.vscode-server/bin/1e790d77f81672c49be070e04474901747115651/node /tmp/vscode-remote-containers-949b6f28-d28f-424d-aec2-3f737650e067.js git-credential-helper $*; }; f"
[pull]
	rebase = false
[push]
	autoSetupRemote = true
