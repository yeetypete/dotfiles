#!/bin/sh
# Pick a random wallpaper from ~/Pictures/Wallpapers and apply it to all outputs.
set -eu

dir="$HOME/Pictures/Wallpapers"
[ -d "$dir" ] || exit 0

img=$(find "$dir" -type f \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \) | shuf -n 1)
[ -n "$img" ] || exit 0

swaymsg output '*' bg "$img" fill
