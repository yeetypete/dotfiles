#!/bin/bash

if [ -z "$1" ]; then
    echo "Usage: workspace [default|remote]"
    exit 1
fi

if [ "$1" == "default" ]; then
    xrandr --output DP-4.8 --mode 1920x1200 --rate 75.00 --primary --left-of DP-2.8 
    xrandr --output DP-2.8 --mode 1920x1200 --rate 75.00 --right-of DP-4.8

elif [ "$1" == "remote" ]; then
    xrandr --output DP-4.8 --mode 1920x1080 --primary
    xrandr --output DP-2.8 --off
else
    echo "Usage: $0 [default|remote]"
    exit 1
fi