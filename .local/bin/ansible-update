#!/bin/bash

export ANSIBLE_FORCE_COLOR=1
export PY_COLORS=1
export PYTHONUNBUFFERED=1
export ANSIBLE_HOST_PATTERN_MISMATCH=ignore
export ANSIBLE_LOG_PATH=$HOME/.ansible/log

extra_opts=""

# Check if passwordless sudo is enabled.
if ! sudo -n true 2>/dev/null; then
    extra_opts+=" --ask-become-pass"
fi

# shellcheck disable=SC2086
ansible-pull ansible/desktops.yml \
    -U git@github.com:yeetypete/homelab.git \
    -C main \
    -i ansible/inventory/inventory.yml \
    -e override_hosts=localhost \
    $extra_opts "$@"
