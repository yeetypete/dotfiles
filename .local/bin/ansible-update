#!/bin/bash

export ANSIBLE_FORCE_COLOR=1
export PY_COLORS=1
export PYTHONUNBUFFERED=1
export ANSIBLE_HOST_PATTERN_MISMATCH=ignore
export ANSIBLE_LOG_PATH=$HOME/.ansible/log

ansible-pull ansible/desktops.yml \
    -U git@github.com:yeetypete/homelab.git \
    -C main \
    -i ansible/inventory/inventory.yml \
    -e override_hosts=localhost -K "$@"
