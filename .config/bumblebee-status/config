[core]
modules=playerctl, pulseout, pulsein, xrandr, brightness, caffeine, battery-upower, datetime, dunstctl
theme=dark

[module-parameters]
playerctl.layout=playerctl.prev, playerctl.pause, playerctl.next
pulseout.limit=100
pulsein.limit=100
xrandr.autotoggle=True
xrandr.autotoggle_side=right
brightness.interval=1s
datetime.format=%a %d %b %H:%M
