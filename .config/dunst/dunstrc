[global]
    follow = mouse
    width = (0, 300)
    height = 300
    progress_bar_height = 4
    progress_bar_corner_radius = 1
    frame_width = 1
    font = Monospace 8
    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    corner_radius = 4
    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all
    frame_color = "#d8d8d8"
    separator_color = "#d8d8d8"

[base16_low]
    msg_urgency = "low"
    background = "#282828"
    foreground = "#585858"

[base16_normal]
    msg_urgency = "normal"
    background = "#383838"
    foreground = "#d8d8d8"

[base16_critical]
    msg_urgency = "critical"
    background = "#ab4642"
    foreground = "#e8e8e8"
