#!/bin/bash

# Workaround for NVIDIA DSC (Display Stream Compression) link failing to
# re-establish after suspend/resume on DisplayPort connections.
#
# Sets a non-DSC mode to establish a basic DP link before autorandr
# detects and applies the full DSC mode.

chassis=$(cat /sys/class/dmi/id/chassis_type 2>/dev/null)
if [[ ! "$chassis" =~ ^(3|4|6|7)$ ]]; then
    exit 0
fi

xrandr --output DP-0 --mode 3840x2160 --rate 120
